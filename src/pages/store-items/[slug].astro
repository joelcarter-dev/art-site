---
// Faithful port of the original art-pice template:
// black viewport-fit grid — fixed header bar, back arrow, centred cinzel
// title, 250px left sidebar (Info/Notes toggle, cream price bar, data
// lists, 200px bordered buttons), centred artwork image (max 800px).
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import OrderModal from '../../components/OrderModal.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config.js';

export async function getStaticPaths() {
  const artworks = await getCollection('artwork', ({ data }) => data.is_store_item);
  return artworks.map(entry => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

// ── Price state (original logic preserved) ─────────────────────────────────
const isSold       = data.price?.toLowerCase() === 'sold';
const isCommission = (data.tags ?? []).some(t => t.toLowerCase() === 'commission');
const isArchived   = (data.tags ?? []).some(t => t.toLowerCase() === 'archived');
const hasPrice     = data.price && data.price !== '' && data.price !== '0' && !isSold && !isCommission && !isArchived;

const numericPrice = Number(String(data.price ?? '').replace(/[^0-9.-]+/g, '')) || 0;
const displayPrice = hasPrice ? numericPrice + siteConfig.globalItemBuffer : null;

const archiveSlug = `/archive/${entry.slug}`;
const pageTitle   = `${data.title} — ${siteConfig.seoTitle}`;
const pageDesc    = data.about ?? data.title;

const arrowSvg = readFileSync(new URL('../../../public/arrow-back.svg', import.meta.url), 'utf8');
---

<BaseLayout title={pageTitle} description={pageDesc} image={data.featuredImage}>

  <section class="art-item-holder">

    <div class="art-pice-header">
      <Header leftLink="home" rightLink="archive" white={true} />
    </div>

    <button type="button" class="back-button" onclick="history.back()" aria-label="Go back">
      <Fragment set:html={arrowSvg} />
    </button>

    <h1 id="title">{data.title}</h1>

    <div class="left">
      <div id="sidebar">
        <div id="info-menu">
          <span role="button" tabindex="0" class="selected" data-view="info">Info</span>
          <span role="button" tabindex="0" data-view="notes">Notes</span>
        </div>

        <!-- Info view -->
        <div class="info-holder" data-panel="info">
          <div class="price-holder">
            <div class="price">
              {isSold && <h3 class="price-state">Sold</h3>}
              {isCommission && <h3 class="price-state price-state--cap">Commissioned Piece</h3>}
              {isArchived && !isSold && !isCommission && <h3 class="price-state price-state--cap">Archived Piece</h3>}
              {displayPrice && (
                <>
                  <h3>${displayPrice}</h3>
                  <span>NZD</span>
                </>
              )}
              {!hasPrice && !isSold && !isCommission && !isArchived && (
                <h3 class="price-state price-state--cap">Enquire</h3>
              )}
            </div>
          </div>

          <ul class="data-list">
            <li><p>{data.original ? 'original work' : 'print'}</p></li>
            {data.info && <li class="no-transform"><p>{data.info}</p></li>}
          </ul>

          <ul class="data-list">
            {(data.type ?? []).map(t => <li><i>{t}</i></li>)}
          </ul>

          <div class="button-holder">
            {hasPrice && (
              <button
                class="art-item-button"
                id="order-btn"
                data-title={data.title}
                data-price={numericPrice}
              >
                <span>Place Order</span>
              </button>
            )}

            {data.is_archive_item && (
              <button class="art-item-button">
                <a href={archiveSlug} class="store-link">View In Archive</a>
              </button>
            )}

            {(isArchived || isSold) && (
              <button class="art-item-button">
                <a href={`/make-offer?item=${encodeURIComponent(data.title)}`} class="store-link">Make An Offer</a>
              </button>
            )}
          </div>
        </div>

        <!-- Notes view -->
        <div class="notes-holder" data-panel="notes" hidden>
          <h3>Artists Notes</h3>
          <div class="notes">
            {data.artistNotes
              ? <p set:html={data.artistNotes.replace(/\n/g, '<br>')} />
              : <p>Notes are yet to come</p>
            }
            {entry.body && <Content />}
          </div>
        </div>
      </div>
    </div>

    <div class="image-holder">
      <div class="inner-image">
        <img
          src={data.featuredImage}
          alt={data.about || data.title}
          loading="eager"
        />
      </div>
    </div>

    <div class="right"></div>

    <OrderModal />
  </section>
</BaseLayout>

<script>
  // ── Info / Notes toggle ─────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('#info-menu span').forEach(span => {
    const activate = () => {
      document.querySelectorAll('#info-menu span').forEach(s => s.classList.remove('selected'));
      span.classList.add('selected');
      const view = span.dataset.view;
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach(p => {
        p.hidden = p.dataset.panel !== view;
      });
    };
    span.addEventListener('click', activate);
    span.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') activate(); });
  });

  // ── Order button ────────────────────────────────────────────────────
  const orderBtn = document.getElementById('order-btn');
  if (orderBtn) {
    orderBtn.addEventListener('click', () => {
      const title = orderBtn.dataset.title!;
      const price = Number(orderBtn.dataset.price!);
      (window as any).openOrderModal(title, price);
    });
  }
</script>

<style lang="scss">
  @use '../../styles/variables' as *;

  @keyframes sidebar-fadein {
    from { opacity: 0; margin-left: -20px; }
    to   { opacity: 1; margin-left: 0; }
  }

  @keyframes underline-grow {
    from { width: 20px; }
    to   { width: 50px; }
  }

  .art-item-holder {
    background-color: $main-black;
    width: 100%;
    display: grid;
    grid-template-areas:
      "header header header"
      "title title title"
      "left-sidebar main sidebar"
      "footer footer footer";
    grid-template-columns: minmax(100px, 1fr) 3fr minmax(100px, 1fr);
    grid-template-rows: 160px 60px 0.7fr 60px;
    max-height: 100vh;

    @media screen and (max-width: 100em) {
      grid-template-columns: minmax(200px, 300px) 3fr;
      .image-holder { grid-column: 2 / span 3; }
    }

    @media screen and (max-width: #{$m}) {
      grid-template-areas: "top" "bottom";
      grid-template-columns: 100%;
      grid-template-rows: auto auto;
      max-height: none;

      #title {
        margin-top: 40px;
        grid-area: top;
        line-height: 30px;
      }

      .image-holder {
        padding: 65px 0 0;
        margin: 0 auto;
        grid-area: top;
        margin-top: 60px;
        grid-column: auto;
      }

      .left {
        z-index: 2;
        background-color: $main-black;
        grid-area: bottom;
      }
    }
  }

  .art-pice-header {
    grid-area: header;
    width: 100%;
    height: 100px;
    background-color: $main-black;
  }

  .back-button {
    grid-area: title-start;
    z-index: 2;
    width: 100px;
    height: 30px;
    margin-left: 5vw;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    text-align: left;

    :global(svg) {
      width: 24px;
      height: 24px;
      :global(polyline) { stroke: $red-white; }
    }
    &:hover :global(polyline) { stroke-width: 3; }
  }

  #title {
    color: $red-white;
    text-align: center;
    font-weight: 100;
    line-height: 0;
    font-family: $font-sub;
    grid-area: title;
    text-transform: capitalize;
    font-size: clamp(25px, 3vw, 30px);
    z-index: 1;
    margin: 0;
  }

  .left, .right { grid-row: 3; }

  .left {
    grid-area: left-sidebar;
    :global(*) {
      animation: sidebar-fadein 0.5s;
    }
  }

  .right { grid-area: sidebar; }

  .image-holder {
    grid-area: main;
    position: relative;
    padding: 3vw 60px 60px 0;
    background-color: $main-black;
    width: 100%;
    max-width: 800px;
    height: auto;
    margin: 0 auto;

    @media screen and (min-width: #{$s}) { padding: 3vw; }
    @media screen and (max-width: #{$s}) { width: 100%; padding: 0; }

    .inner-image {
      display: grid;
      width: 100%;

      img {
        width: 100%;
        height: auto;
        max-height: calc(100vh - 280px);
        object-fit: contain;
        display: block;
      }

      @media screen and (max-width: 40em) {
        padding-top: 10vw;
        max-width: 100vw !important;
        img { max-height: none; }
      }
    }
  }

  // ── Sidebar ─────────────────────────────────────────────────────────
  #sidebar {
    height: 100%;
    margin: 0 auto;
    margin-top: 3vw;
    position: relative;
    font-family: $font-body;
    font-weight: 300;
    text-transform: uppercase;
    background-color: $main-black;

    @media screen and (max-width: #{$m}) {
      float: none;
      padding-top: 60px;
      max-width: 400px;
      margin: 0 auto;
      padding-bottom: 40px;
    }

    #info-menu {
      width: 250px;
      height: 60px;
      display: flex;
      justify-content: space-evenly;
      margin-bottom: 30px;

      @media screen and (max-width: #{$m}) { width: 100%; }

      span {
        width: 50%;
        max-width: 150px;
        height: 43px;
        color: $red-white;
        font-size: 20px;
        text-align: center;
        cursor: pointer;
        border: none;
        opacity: 0.5;
        transition: all 0.5s ease-in-out;
        outline: none;

        &:hover { opacity: 1; }
      }

      .selected {
        opacity: 1;

        &::before {
          content: '';
          display: block;
          width: auto;
          position: relative;
          top: 40px;
          border: none;
          border-bottom: 3px solid $red-white;
          animation: underline-grow 1s forwards;
          transition: all 1s linear;
        }
      }
    }

    .info-holder {
      width: 250px;
      @media screen and (max-width: #{$m}) { width: 100%; }

      .price-holder {
        width: 100%;
        display: flex;
        position: relative;

        .price {
          color: $main-black;
          background-color: $red-white;
          font-size: 25px;
          padding: 8px;
          margin: 0 auto;
          width: 100%;
          display: flex;
          justify-content: center;
          align-items: baseline;

          h3 {
            margin: 0;
            font-weight: 300;
            color: $main-black;
          }

          span {
            font-size: 16px;
            color: $main-black;
            margin-left: 6px;
          }

          .price-state {
            text-transform: uppercase;
            font-family: $font-sub;
            font-size: 0.7em;
          }

          .price-state--cap { text-transform: capitalize; }
        }
      }

      .data-list {
        list-style: none;
        padding: 0;
        margin-bottom: 30px;
        width: 100%;
        padding-left: 20px;

        @media screen and (max-width: #{$m}) { padding-left: 0; }

        li {
          width: 240px;
          color: $red-white;
          font-size: clamp(16px, 1.5vw, 18px);
          text-transform: capitalize;
          letter-spacing: 1px;

          &.no-transform { text-transform: none; }

          p { margin: 8px 0; }
          i { padding: 15px; }

          @media screen and (max-width: #{$m}) {
            width: 100%;
            text-align: center;
          }
        }
      }

      .button-holder {
        position: relative;
        padding-left: 24px;
        display: inline-grid;
        transition: all 0.5s cubic-bezier(0.77, 0, 0.18, 1);

        @media screen and (max-width: #{$m}) {
          padding: 0;
          display: flex;
          flex-direction: column;
          align-items: center;
          width: 100%;
        }

        .art-item-button {
          width: 200px;
          margin: 0 auto;
          padding: 20px 0;
          border: 1px solid $red-white;
          color: $red-white;
          background-color: transparent;
          margin-bottom: 30px;
          cursor: pointer;
          font-size: 18px;
          letter-spacing: 2px;
          font-family: $font-body;
          text-transform: uppercase;

          a, span {
            width: 100%;
            text-decoration: none;
            margin: 0 auto;
            color: $red-white;
            font-size: 16px;
          }
        }
      }
    }

    .notes-holder {
      color: $red-white;
      text-align: left;
      padding: 0 30px;
      max-width: 400px;

      h3 {
        font-weight: 100;
        font-size: 20px;
        margin-bottom: 40px;

        &::before {
          content: '';
          display: block;
          width: 30%;
          position: relative;
          top: 40px;
          border: none;
          border-bottom: 2px solid $red-white;
          animation: underline-grow 1s forwards;
          transition: all 1s linear;
        }
      }

      .notes :global(p) {
        font-family: $font-prose;
        text-transform: none;
      }
    }
  }
</style>
