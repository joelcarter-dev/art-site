---
// Faithful port of the original store page:
// cream page with three text-list columns (Categories / Mediums /
// Commissions & Comercial) linking to category & medium index pages,
// then the angled SVG transition into the black "Personally Selected"
// section with the rune ornament, selected works and the-traide sketch.
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommissionSection from '../components/CommissionSection.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config.js';
import { kebabCase } from '../utils.js';

const COMMERCIAL_TAGS = ['Commercial', 'Maps', 'Logos', 'Commission'];

const allStore = await getCollection('artwork', ({ data }) => data.is_store_item);

// posts: store items that do NOT carry a commercial tag
const posts = allStore.filter(i => !(i.data.tags ?? []).some(t => COMMERCIAL_TAGS.includes(t)));

// group helpers (Gatsby-style group: item counted once per value)
function group(items: typeof allStore, field: 'tags' | 'type') {
  const counts: Record<string, number> = {};
  items.forEach(i => (i.data[field] ?? []).forEach((v: string) => {
    counts[v] = (counts[v] ?? 0) + 1;
  }));
  return Object.keys(counts).sort().map(fieldValue => ({ fieldValue, totalCount: counts[fieldValue] }));
}

const tagGroups  = group(posts, 'tags');
const typeGroups = group(posts, 'type');

// commercial: any artwork carrying one of the commercial tags
const allArtwork = await getCollection('artwork');
const commercialItems = allArtwork.filter(i => (i.data.tags ?? []).some(t => COMMERCIAL_TAGS.includes(t)));
const commercialGroups = group(commercialItems, 'tags');

const selected = allStore.filter(i => i.data.storeHighlight).reverse();

const sidesSvg  = readFileSync(new URL('../../public/sides-transition.svg', import.meta.url), 'utf8');
const runesSvg  = readFileSync(new URL('../../public/three-runes.svg', import.meta.url), 'utf8');
const traideSvg = readFileSync(new URL('../../public/the-traide.svg', import.meta.url), 'utf8');
const armySvg   = readFileSync(new URL('../../public/tiny-army.svg', import.meta.url), 'utf8');
---

<BaseLayout title={`Store — ${siteConfig.seoTitle}`} description="Browse and purchase original artworks from the Heart of Arah.">
  <section id="store">
    <Header leftLink="home" rightLink="archive" white={false} />

    <div class="list-holder">

      <div class="item-list">
        <span>Sort By</span>
        <h3>Categories</h3>
        <ul>
          {tagGroups.map(g => (
            <li><a href={`/category/${kebabCase(g.fieldValue)}/`}>{g.totalCount} {g.fieldValue}</a></li>
          ))}
        </ul>
      </div>

      <div class="item-list">
        <span>Sort By</span>
        <h3>Mediums</h3>
        <ul>
          {typeGroups.map(g => (
            <li><a href={`/mediums/${kebabCase(g.fieldValue)}/`}>{g.totalCount} {g.fieldValue}</a></li>
          ))}
        </ul>
      </div>

      <div class="item-list">
        <span>Sort By</span>
        <h3>Commissions &amp; Comercial</h3>
        <ul>
          {commercialGroups.map(g => (
            <li><a href={`/category/${kebabCase(g.fieldValue)}/`}>{g.totalCount} {g.fieldValue}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <section id="bottom-holder">

      <div class="svgs">
        <div class="angle-svg-holder">
          <Fragment set:html={sidesSvg} />
        </div>
        <div id="tiny-army" aria-hidden="true">
          <Fragment set:html={armySvg} />
        </div>
      </div>

      <div class="black">
        <div class="commissions-holder">
          <CommissionSection dark={false} />
        </div>

        <div id="selected-holder">
          <h2 id="selected-title">Personally Selected</h2>
          <div id="three-runes" aria-hidden="true">
            <Fragment set:html={runesSvg} />
          </div>
          <div class="items">
            {selected.map(item => (
              <div class="selected-item">
                <a href={`/store-items/${item.slug}`}>
                  <h3>{item.data.title}</h3>
                  <img src={item.data.featuredImage} alt={item.data.title} loading="lazy" />
                </a>
              </div>
            ))}
          </div>

          <div id="the-traide" aria-hidden="true">
            <Fragment set:html={traideSvg} />
          </div>
        </div>
      </div>

    </section>

    <Footer white={false} />
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/variables' as *;

  #store {
    background-color: $red-white;
    min-height: 100%;
    width: 100%;
    padding: 0;
    margin: 0;
    overflow-x: hidden;

    :global(*) { color: $red-black; }
  }

  // ── Text lists ──────────────────────────────────────────────────────────
  .list-holder {
    width: 100%;
    min-height: max-content;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: -150px;

    @media screen and (max-width: #{$m}) { margin-bottom: -50px; }

    .item-list {
      min-width: 320px;
      max-width: 340px;
      min-height: 200px;
      position: relative;
      padding: 30px;
      padding-bottom: 100px;
      z-index: 9;
      margin-top: 30px;

      @media screen and (max-width: #{$m}) { padding-bottom: 30px; }

      span {
        float: left;
        font-weight: 300;
        opacity: 0.8;
      }

      h3 {
        width: 100%;
        float: left;
        margin-top: 10px;
        font-weight: 400;
        margin-bottom: 0;
      }

      ul {
        list-style: none;
        border-left: 2px solid $red-black;
        padding-left: 20px;
        margin: 20px 0 0 40px;
        float: left;
        width: 200px;
        height: auto;

        li {
          padding: 5px;
          a { text-decoration: none; }
        }
      }
    }
  }

  // ── Transition + black section ─────────────────────────────────────────
  #bottom-holder {
    .svgs {
      position: relative;

      .angle-svg-holder {
        margin-bottom: -5px;
        :global(svg) {
          display: block;
          width: 100%;
          height: auto;
          margin-bottom: -6px;
        }
      }

      #tiny-army {
        width: 100px;
        margin: 0 auto;
        position: absolute;
        right: 0;
        top: -41px;
        transform: rotate(-16deg);
        :global(svg) { display: block; width: 100%; height: auto; }
      }
    }

    .black {
      background-color: $main-black;

      :global(*) { color: $red-white; }

      .commissions-holder {
        max-width: 400px;
        margin: 0 auto;
      }

      #selected-holder {
        width: 100%;
        position: relative;

        #selected-title {
          color: $red-white;
          width: 100%;
          font-weight: 300;
          font-size: clamp(30px, 4vw, 50px);
          text-align: center;
          padding: 60px;
          padding-bottom: 0;
          margin: 0 auto;
          letter-spacing: 2px;
          font-family: $font-sub;
        }

        #three-runes {
          width: 40px;
          margin: 0 auto;
          top: -100px;
          position: relative;

          :global(*) { fill: $red-white; }
          :global(svg) {
            transform: rotate(-90deg);
            display: block;
            width: 100%;
            height: auto;
          }
        }

        .items {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          width: 100%;
          position: relative;
          top: -210px;

          @media screen and (max-width: #{$s}) { display: block; }

          .selected-item {
            margin: 60px;
            padding-top: 0;
            width: 320px;
            position: relative;

            @media screen and (max-width: #{$s}) {
              margin: 0 auto;
              margin-bottom: 60px;
              h3 { text-align: center; }
            }

            img {
              width: 320px;
              height: 320px;
              object-fit: cover;
              display: block;
              @media screen and (max-width: #{$s}) { margin: 0 auto; }
            }

            h3 {
              color: $red-white;
              font-weight: 300;
              position: relative;
              padding-bottom: 20px;
              font-family: $font-sub;
              text-transform: uppercase;
              max-width: max-content;
              margin-left: 2em;

              &::before {
                content: '';
                display: block;
                max-width: 200px;
                position: absolute;
                bottom: 4px;
                border: none;
                border-bottom: 2px solid $red-white;
                animation: selected-grow 1s forwards;
                transition: all 1s linear;
              }
            }
          }
        }

        #the-traide {
          max-width: 400px;
          margin: 0 auto;
          top: -100px;
          position: relative;

          :global(*) { fill: $red-white; stroke: $red-white; }
          :global(svg) { display: block; width: 100%; height: auto; }
        }
      }
    }
  }

  @keyframes selected-grow {
    from { width: 10%; }
    to   { width: 40%; }
  }
</style>
