---
// Faithful port of the original Gatsby homepage:
// #landing is the scroll container; title/photo/mid are absolutely
// positioned sections (title 28vh, photo 115vh pane, mid at 90vh).
// Cream wedges + vivus drawings + cream 200px logo mark the transition,
// then the cream mid-content: title, 3 random item links, the tiny
// three-travelers divider, about text, commissions, sketch, footer.
import { readFileSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommissionSection from '../components/CommissionSection.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config.js';

const storeItems = await getCollection('artwork', ({ data }) => data.is_store_item);
const linkCandidates = storeItems.map(i => ({ title: i.data.title, slug: `/store-items/${i.slug}` }));

const travelersSvg = readFileSync(new URL('../../public/sketch-travelers.svg', import.meta.url), 'utf8');
const sketchOneSvg = readFileSync(new URL('../../public/sketch-one.svg', import.meta.url), 'utf8');
---

<BaseLayout>
  <div id="landing">

    <Header leftLink="store" rightLink="archive" white={true} />

    <!-- Hero photo pane (slides up behind the solid header) -->
    <section class="hero">
      <div class="hero-top">
        <img src="/img/mainTwo.jpg" alt="Heart of Arah hero image" loading="eager" />
      </div>

      <!-- Title over the hero photo -->
      <div class="title">
        <h1>{siteConfig.title}</h1>
        <h2>{siteConfig.tagLine}</h2>
      </div>
    </section>

    <!-- Mid section, overlapping the photo from 90vh -->
    <section class="mid">

      <!-- Cream wedges rising toward the centre -->
      <div class="sides">
        <div class="right"></div>
        <div class="left"></div>
      </div>

      <!-- Vivus line drawings flanking the transition -->
      <div class="svg-holder">
        <div class="top-svg-holder">
          <div class="svg-left" id="vivus-left"></div>
          <div class="svg-right" id="vivus-right"></div>
        </div>
      </div>

      <!-- Cream logo mark on the photo seam -->
      <div class="main-logo" aria-hidden="true">
        <svg viewBox="0 0 240 120" xmlns="http://www.w3.org/2000/svg">
          <g fill-rule="nonzero">
            <path d="M239.549004,120 L239.64109,119.907914 L238.720553,118.987378 L238.954003,118.987378 L191.666941,71.9337656 L152.74299,33.0098147 L120.155863,65.5969419 L87.5539623,32.9950415 L0.641089603,119.907914 L0.733175603,120 L239.549004,120 Z"></path>
            <polygon points="90.0926935 30.6263153 89.8553375 30.6263153 89.8510974 30.6220752 120.473173 0 151.099488 30.6263153 151.086256 30.6263153 151.148903 30.6889624 135.837865 46 120.589475 30.7516095 105.341084 46 90.0300464 30.6889624"></polygon>
          </g>
        </svg>
      </div>

      <!-- Cream content -->
      <div class="mid-content">

        <div class="mid-title">
          <h2>All PAths leAd to THe MountAin</h2>
        </div>

        <!-- Three random item links -->
        <div class="top-items">
          <div class="random-holder">
            <h2 id="random-links"></h2>
          </div>
        </div>

        <!-- Tiny three-travelers ornament on a rule -->
        <div id="sketch-two">
          <span class="border"></span>
          <Fragment set:html={travelersSvg} />
        </div>

        <div class="about">
          <p>
            All works are original. Much of the work here draws heavily from music, and is based on a setting with deep internal lore. It attempts to explore and symbolise ancient ideas of the human experience in a unique, mythical way.
          </p>
          <p>
            The words of distant places
          </p>
        </div>

        <CommissionSection dark={true} />

        <div id="sketch-one" aria-hidden="true">
          <Fragment set:html={sketchOneSvg} />
        </div>

        <Footer white={true} />
      </div>
    </section>

  </div>
</BaseLayout>

<script define:vars={{ linkCandidates }}>
  // Random item links — shuffled per page load like the original
  const shuffled = linkCandidates.sort(() => 0.5 - Math.random()).slice(0, 3);
  const holder = document.getElementById('random-links');
  if (holder) {
    shuffled.forEach(({ title, slug }) => {
      const a = document.createElement('a');
      a.href = slug;
      a.textContent = title;
      holder.appendChild(a);
    });
  }

  // Vivus SVG path-draw animations
  const script = document.createElement('script');
  script.src = '/vivus.min.js';
  script.onload = () => {
    if (document.getElementById('vivus-left')) {
      new window.Vivus('vivus-left', {
        file: '/home-left.svg',
        type: 'delayed',
        animTimingFunction: window.Vivus.EASE_OUT,
        duration: 1500,
        forceRender: true,
        start: 'autostart',
      });
    }
    if (document.getElementById('vivus-right')) {
      new window.Vivus('vivus-right', {
        file: '/home-right.svg',
        type: 'delayed',
        animTimingFunction: window.Vivus.EASE_OUT,
        duration: 3000,
        forceRender: true,
        start: 'autostart',
      });
    }
  };
  document.head.appendChild(script);
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  #landing {
    width: 100%;
    padding: 0;
    overflow-x: hidden;
  }

  // ── Hero photo ─────────────────────────────────────────────────────────────
  // In flow but pulled up 130px so the photo starts behind the solid header,
  // exactly like the original's viewport-anchored absolute sections.
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;          /* flow space: photo pane itself is 115vh and  */
    margin-top: -130px;     /* overflows below, beneath the mid's open top */
    background-color: $red-white;
    z-index: 0;

    .hero-top {
      width: 100%;
      height: 115vh;
      overflow: hidden;
      position: relative;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: left bottom;
        display: block;
      }
    }
  }

  // ── Title ──────────────────────────────────────────────────────────────────
  .title {
    position: absolute;
    left: 0;
    right: 0;
    top: 28vh;
    text-align: center;
    z-index: 2;

    h1, h2 {
      font-family: $font-heading;
      font-weight: 100;
      color: $red-white;
      padding: 0 20px;
      margin: 0 auto;
    }

    h1 {
      font-size: clamp(40px, 7vw, 100px);
      letter-spacing: 10px;
      margin-bottom: 1rem;
    }

    h2 {
      font-size: clamp(20px, 2.5vw, 35px);
      letter-spacing: 5px;
    }
  }

  // ── Mid ────────────────────────────────────────────────────────────────────
  .mid {
    position: relative;
    margin-top: -10vh;      /* mid begins at 90vh, overlapping the photo */
    z-index: 2;
    width: 100%;

    .sides {
      top: 0;
      z-index: 3;
      position: absolute;
      width: 100%;

      @media screen and (min-width: #{$m}) { top: -20px; }

      .left, .right {
        width: 60vw;
        height: 20vw;
        max-height: 300px;
        min-height: 200px;
        top: 150px;
        position: absolute;
        background-color: $red-white;
      }

      .left {
        left: -20px;
        transform: rotate(-20deg);
        transform-origin: top left;
        @media screen and (min-width: #{$l}) { transform: rotate(-18deg); }
        @media screen and (min-width: 75em)  { transform: rotate(-15deg); }
      }

      .right {
        right: -20px;
        transform: rotate(20deg);
        transform-origin: top right;
        @media screen and (min-width: #{$l}) { transform: rotate(18deg); }
        @media screen and (min-width: 75em)  { transform: rotate(15deg); }
      }
    }

    .main-logo {
      position: relative;
      margin: 0 auto;
      width: 200px;
      top: 7px;
      z-index: 2;

      @media screen and (max-width: #{$xs}) { width: 150px; }

      svg {
        display: block;
        width: 100%;
        height: auto;
        path, polygon { fill: $red-white !important; }
      }
    }

    .mid-content {
      z-index: 5;
      background-color: $red-white;
      position: relative;
      padding: 40px 0;

      .mid-title {
        padding: 1vw 30px 0;
        text-align: center;
        font-family: $font-heading;
        position: relative;

        @media screen and (max-width: #{$m}) { padding: 10vw 30px 0; }
        @media screen and (max-width: #{$s}) { padding: 1vw 10px 0; }

        h2 {
          color: $main-black;
          font-family: $font-heading;
          font-weight: 400;
          z-index: 5;
          margin-bottom: 0;
        }
      }

      .top-items {
        display: flex;
        justify-content: center;
        margin: 0 auto;
        height: 100px;
      }

      .about {
        width: 100%;

        p {
          max-width: 600px;
          margin: 0 auto;
          padding: 0 60px;
          text-align: justify;
          margin-top: 20px;
          color: $main-black;

          @media screen and (max-width: #{$xs}) { padding: 0 30px; }
        }
      }
    }
  }

  // ── Random links ───────────────────────────────────────────────────────────
  .random-holder {
    :global(h2) {
      text-align: center;
      max-width: 600px;
      padding: 0 30px;
      margin-bottom: 100px;

      @media screen and (max-width: #{$s}) { padding: 0 10px; }
    }

    :global(a) {
      padding: 0 10px;
      color: $main-black;
      text-transform: capitalize;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
    }
  }

  // ── Vivus drawings ─────────────────────────────────────────────────────────
  .svg-holder {
    position: relative;
    width: 100vw;
    z-index: 6;
  }

  .top-svg-holder {
    position: relative;
    width: 100vw;
    display: flex;
    top: 19vh;

    @media screen and (max-width: #{$s}) { display: none; }
  }

  .svg-left, .svg-right {
    width: 37%;
    max-width: 350px;
    position: absolute;
    bottom: -60px;

    :global(svg) { display: block; width: 100%; height: auto; }
    :global(svg g path) { stroke: $main-black !important; }
  }

  .svg-left { left: 0; }

  .svg-right {
    right: 14px;
    @media screen and (max-width: #{$s}) { right: 0; }
  }

  // ── Sketches ───────────────────────────────────────────────────────────────
  #sketch-one {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 999;
    width: 100px;

    :global(svg) { display: block; width: 100%; height: auto; }
    :global(svg g path) { fill: $main-black; }

    @media screen and (max-width: #{$m}) { width: 50px; }
  }

  #sketch-two {
    max-width: 540px;
    display: flex;
    justify-content: center;
    padding: 10px 60px 50px;
    margin: 0 auto;
    position: relative;

    .border {
      height: 2px;
      width: 100%;
      position: absolute;
      background-color: $main-black;
      margin-top: 16px;
      z-index: 0;
      padding: 0 60px;
    }

    :global(svg) {
      width: 96px;
      height: 30px;
      background-color: $red-white;
      padding: 0 15px;
      position: relative;
      z-index: 1;
    }
  }
</style>
