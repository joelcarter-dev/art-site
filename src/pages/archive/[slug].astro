---
// Faithful port of the original archive-item template:
// dark top — back arrow + centred Cinzel Decorative title + centred
// artwork image + "view in store" link — then the cream reading body
// (Lora, justified, 500px measure), cream footer.
import { readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config.js';

export async function getStaticPaths() {
  const items = await getCollection('artwork', ({ data }) => data.is_archive_item);
  return items.map(entry => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const storeSlug = `/store-items/${entry.slug}`;
const arrowSvg = readFileSync(new URL('../../../public/arrow-back.svg', import.meta.url), 'utf8');
---

<BaseLayout
  title={`${data.title} — Archive — ${siteConfig.seoTitle}`}
  description={data.about}
  image={data.featuredImage}
>
  <section id="archive-item">
    <Header leftLink="home" rightLink="store" white={true} />

    <div class="holder">
      <section class="body">

        {data.featuredImage && (
          <section class="img-header">
            <div class="top">
              <button type="button" class="back-button" onclick="history.back()" aria-label="Go back">
                <Fragment set:html={arrowSvg} />
              </button>
              <h1 id="title">{data.title}</h1>
            </div>

            <img class="inner-image" src={data.featuredImage} alt={data.title} loading="eager" />

            {data.is_store_item && (
              <div class="store-item-link">
                <h3>This piece is a store item</h3>
                <a href={storeSlug} class="store-link">view in store</a>
              </div>
            )}
          </section>
        )}

        <div class="body-holder">
          <div class="body-content">
            <Content />
          </div>
        </div>

      </section>
    </div>

    <Footer white={true} />
  </section>
</BaseLayout>

<style lang="scss">
  @use '../../styles/variables' as *;

  #archive-item {
    width: 100%;
    overflow-x: hidden;
    background-color: $main-black;
  }

  .holder {
    background-color: $main-black;
  }

  .img-header {
    margin: 0 auto;
    position: relative;
    padding: 0 100px 100px;
    max-width: 1000px;

    @media screen and (max-width: #{$m}) { padding: 0 0 60px; }

    .top {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;

      @media screen and (max-width: #{$s}) { display: block; }
    }

    .back-button {
      position: absolute;
      left: 0;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 10px;

      :global(svg) {
        width: 24px;
        height: 24px;
        display: block;
        :global(polyline) { stroke: $red-white; }
      }
      &:hover :global(polyline) { stroke-width: 3; }

      @media screen and (max-width: #{$s}) { position: relative; }
    }

    .inner-image {
      width: 100%;
      height: auto;
      display: block;
    }

    .store-item-link {
      position: relative;
      margin: 0 auto;
      width: 300px;
      height: 100px;
      padding-top: 20px;
      text-align: center;

      @media screen and (max-width: #{$m}) { height: 140px; }

      h3 {
        color: $red-white;
        font-weight: 400;
        text-align: center;
        font-family: $font-body;
        letter-spacing: 2px;
      }

      .store-link {
        border: 1px solid $red-white;
        padding: 20px;
        text-decoration: none;
        color: $red-white;
        display: inline-block;
        font-family: $font-body;
        letter-spacing: 2px;
      }
    }
  }

  #title {
    font-size: clamp(20px, 2.2vw, 25px);
    font-family: $font-heading;
    text-align: center;
    padding: 40px 15px 60px;
    margin: 0 auto;
    max-width: max-content;
    letter-spacing: 2px;
    color: $red-white;
    font-weight: 400;
  }

  .body-holder {
    width: 100%;
    background-color: $red-white;
    position: relative;
  }

  .body-content {
    margin: 0 auto;
    padding-bottom: 100px;
    padding-top: 5rem;
    text-align: justify;
    background-color: $red-white;

    @media screen and (max-width: #{$m}) {
      width: 100%;
      padding: 30px;
    }

    :global(*) {
      line-height: 30px;
      font-family: $font-prose;
      letter-spacing: 2px;
      max-width: 500px;
      margin: 0 auto;
      color: $main-black;
    }

    :global(p) { margin-bottom: 10px; }

    :global(h1), :global(h2), :global(h3) {
      font-family: $font-sub;
      line-height: 1.4;
    }

    :global(img) {
      width: 100%;
      height: auto;
      display: block;
      padding: 20px 0;
    }
  }
</style>
