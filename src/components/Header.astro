---
// Exact port of the original Header (header.module.sass):
// - relative solid bar; white={true} → #0B101B bg with cream elements,
//   white={false} → cream bg with dark elements
// - logoHolder flex, max-width 588px; mainLogo 50% (min 100px), svg 60px tall
// - Vivus-animated arch (logo-side-left.svg) absolutely positioned at
//   top 10px, max-width 268px, bleeding 30px over the centre logo;
//   right side mirrored with rotateY(180deg)
// - links: 25px, line-height 130px, opacity .8, animated 3px underline
interface Props {
  leftLink?: 'home' | 'store' | 'archive';
  rightLink?: 'home' | 'store' | 'archive';
  white?: boolean;
}

const { leftLink = 'home', rightLink = 'store', white = false } = Astro.props;

const links: Record<string, { href: string; label: string }> = {
  home:    { href: '/',        label: 'home'    },
  store:   { href: '/store',   label: 'store'   },
  archive: { href: '/archive', label: 'archive' },
};

const left  = links[leftLink]  ?? links.home;
const right = links[rightLink] ?? links.store;

// unique ids in case two headers render on one page (archive does this)
const uid = Math.random().toString(36).slice(2, 7);
---

<header class={`site-header ${white ? 'holder-white' : 'holder-black'}`}>
  <div class={`logo-holder ${white ? 'scheme-white' : 'scheme-black'}`}>

    <div class="side left">
      <div class="arch" id={`arch-left-${uid}`} data-arch></div>
      <a href={left.href} class="link">{left.label}</a>
    </div>

    <a href="/" class="main-logo" aria-label="Heart of Arah — home">
      <svg viewBox="0 0 147 73" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M79.838 41.831 L79.847 41.821 L73.130 35.104 L66.412 41.821 L66.450 41.859 L54.154 54.154 L0 0 L146.617 0 L92.312 54.305 L79.838 41.831 Z M78.338 43.331 L90.432 55.425 L73.158 72.698 L55.884 55.425 L67.950 43.359 L73.130 48.539 L78.338 43.331 Z"/>
      </svg>
    </a>

    <div class="side right">
      <div class="arch" id={`arch-right-${uid}`} data-arch></div>
      <a href={right.href} class="link">{right.label}</a>
    </div>

  </div>
</header>

<script>
  function initHeaderArches() {
    const arches = document.querySelectorAll('[data-arch]:not([data-arch-done])');
    if (!arches.length) return;
    const run = () => {
      arches.forEach((el) => {
        el.setAttribute('data-arch-done', '1');
        new (window as any).Vivus(el.id, {
          file: '/logo-side-left.svg',
          animTimingFunction: (window as any).Vivus.EASE_OUT,
          type: 'delayed',
          duration: 400,
          reverseStack: true,
          start: 'autostart',
        });
      });
    };
    if ((window as any).Vivus) { run(); return; }
    const s = document.createElement('script');
    s.src = '/vivus.min.js';
    s.onload = run;
    document.head.appendChild(s);
  }
  initHeaderArches();
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  // Header-local colours, exactly as the original header.module.sass
  $header-white: #F0E3DE;
  $header-black: #0B101B;

  .site-header {
    position: relative;
    width: 100%;
    z-index: 900;
  }

  .holder-white { background-color: $header-black; }
  .holder-black { background-color: $header-white; }

  // colour schemes (original #white / #black ids)
  .scheme-white {
    .side :global(svg g path) { stroke: $header-white !important; }
    .side .link { color: $red-white; &::before { border-bottom: 3px solid $red-white; } }
    .main-logo svg path { fill: $header-white !important; }
  }

  .scheme-black {
    .side :global(svg g path) { stroke: $red-black !important; }
    .side .link { color: $red-black; &::before { border-bottom: 3px solid $red-black; } }
    .main-logo svg path { fill: $red-black !important; }
  }

  .logo-holder {
    display: flex;
    justify-content: center;
    max-width: 588px;
    margin: 0 auto;
  }

  .main-logo {
    width: 50%;
    min-width: 100px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;

    svg {
      display: block;
      width: 100%;
      max-width: 147px;
      max-height: 90px;
      height: 60px;
    }
  }

  .side {
    position: relative;
    width: 100%;

    .arch {
      position: absolute;
      top: 10px;
      width: 268px;
      max-width: 268px;
      pointer-events: none;

      :global(svg) {
        display: block;
        width: 100%;
        height: auto;
      }

      @media screen and (max-width: #{$s}) {
        top: 15px;
      }
    }

    .link {
      display: block;
      position: relative;
      opacity: 0.8;
      z-index: 10;
      width: 100%;
      margin: 0 auto;
      font-size: 25px;
      text-decoration: none;
      line-height: 130px;
      font-family: $font-body;
      letter-spacing: 2px;

      &::before {
        content: '';
        display: block;
        position: absolute;
        top: 85px;
        border: none;
        animation: header-underline-grow 1s forwards;
        transition: all 1s linear;
      }

      &:hover::before { width: 90%; }
    }
  }

  .side.left {
    .arch { right: -30px; }
    .link {
      text-align: right;
      &::before { right: 0; float: right; }
    }
  }

  .side.right {
    .arch { left: -30px; transform: rotateY(180deg); }
    .link { text-align: left; }
  }

  @keyframes header-underline-grow {
    from { width: 0%; }
    to   { width: 100px; }
  }
</style>
