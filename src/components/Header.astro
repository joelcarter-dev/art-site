---
// Faithful port of the original Gatsby Header:
// - position: relative (sits at top of page flow, ~130px tall)
// - white={true}  → solid dark bar (#0B101B) with cream logo/links/arches
// - white={false} → cream bar with dark logo/links/arches
// - Vivus-animated arch SVG (logo-side-left.svg) behind each link,
//   right side mirrored, bleeding ±30px over the centre logo
interface Props {
  leftLink?: 'home' | 'store' | 'archive';
  rightLink?: 'home' | 'store' | 'archive';
  white?: boolean;
}

const { leftLink = 'home', rightLink = 'store', white = false } = Astro.props;

const links: Record<string, { href: string; label: string }> = {
  home:    { href: '/',        label: 'home'    },
  store:   { href: '/store',   label: 'store'   },
  archive: { href: '/archive', label: 'archive' },
};

const left  = links[leftLink]  ?? links.home;
const right = links[rightLink] ?? links.store;

// unique ids in case two headers ever render
const uid = Math.random().toString(36).slice(2, 7);
---

<header class={`site-header ${white ? 'scheme-white' : 'scheme-black'}`}>
  <div class="logo-holder">

    <div class="side side--left">
      <div class="arch" id={`arch-left-${uid}`} data-arch></div>
      <a href={left.href} class="link">{left.label}</a>
    </div>

    <a href="/" class="main-logo" aria-label="Heart of Arah — home">
      <svg viewBox="0 0 147 73" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M79.838 41.831 L79.847 41.821 L73.130 35.104 L66.412 41.821 L66.450 41.859 L54.154 54.154 L0 0 L146.617 0 L92.312 54.305 L79.838 41.831 Z M78.338 43.331 L90.432 55.425 L73.158 72.698 L55.884 55.425 L67.950 43.359 L73.130 48.539 L78.338 43.331 Z"/>
      </svg>
    </a>

    <div class="side side--right">
      <div class="arch arch--mirror" id={`arch-right-${uid}`} data-arch></div>
      <a href={right.href} class="link">{right.label}</a>
    </div>

  </div>
</header>

<script>
  function initArches() {
    const arches = document.querySelectorAll('[data-arch]');
    if (!arches.length) return;
    const run = () => {
      arches.forEach((el) => {
        new (window as any).Vivus(el.id, {
          file: '/logo-side-left.svg',
          animTimingFunction: (window as any).Vivus.EASE_OUT,
          type: 'delayed',
          duration: 400,
          reverseStack: true,
          start: 'autostart',
        });
      });
    };
    if ((window as any).Vivus) { run(); return; }
    const s = document.createElement('script');
    s.src = '/vivus.min.js';
    s.onload = run;
    document.head.appendChild(s);
  }
  initArches();
</script>

<style lang="scss">
  @use '../styles/variables' as *;

  // Header-local colours (as in the original header.module.sass)
  $header-black: #0B101B;
  $header-white: #F0E3DE;

  .site-header {
    position: relative;
    width: 100%;
    z-index: 900;
  }

  .scheme-white {
    background-color: $header-black;
    .link { color: $red-white; &::before { border-bottom-color: $red-white; } }
    .main-logo svg path { fill: $header-white; }
    .arch :global(svg g path) { stroke: $header-white !important; }
  }

  .scheme-black {
    background-color: $header-white;
    .link { color: $red-black; &::before { border-bottom-color: $red-black; } }
    .main-logo svg path { fill: $red-black; }
    .arch :global(svg g path) { stroke: $red-black !important; }
  }

  .logo-holder {
    display: flex;
    justify-content: center;
    max-width: 588px;
    margin: 0 auto;
  }

  .main-logo {
    width: 50%;
    min-width: 100px;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;

    svg {
      display: block;
      width: 100%;
      max-width: 147px;
      max-height: 90px;
      height: 60px;
    }
  }

  .side {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  // ── Animated arch SVGs ────────────────────────────────────────────
  .arch {
    position: absolute;
    top: 10px;
    max-width: 268px;
    width: 100%;
    pointer-events: none;

    :global(svg) {
      display: block;
      width: 100%;
      height: auto;
    }

    @media screen and (max-width: #{$s}) {
      top: 15px;
    }
  }

  .side--left .arch { right: -30px; }
  .side--right .arch { left: -30px; transform: rotateY(180deg); }

  // ── Links ─────────────────────────────────────────────────────────
  .link {
    display: block;
    position: relative;
    opacity: 0.8;
    z-index: 10;
    width: 100%;
    margin: 0 auto;
    font-size: 25px;
    text-decoration: none;
    line-height: 130px;
    font-family: $font-body;
    letter-spacing: 2px;

    &::before {
      content: '';
      display: block;
      position: absolute;
      top: 85px;
      border: none;
      border-bottom: 3px solid;
      animation: header-underline-grow 1s forwards;
      transition: all 1s linear;
    }

    &:hover::before { width: 90%; }
  }

  .side--left .link {
    text-align: right;
    &::before { right: 0; }
  }

  .side--right .link {
    text-align: left;
    &::before { left: 0; }
  }

  @keyframes header-underline-grow {
    from { width: 0; }
    to   { width: 100px; }
  }

  @media screen and (max-width: #{$s}) {
    .link { font-size: 18px; line-height: 100px; &::before { top: 70px; } }
    .main-logo svg { height: 50px; }
  }
</style>
