---
interface Props {
  leftLink?: 'home' | 'store' | 'archive';
  rightLink?: 'home' | 'store' | 'archive';
  white?: boolean;
}

const { leftLink = 'home', rightLink = 'store', white = false } = Astro.props;

const links: Record<string, { href: string; label: string }> = {
  home:    { href: '/',        label: 'home'    },
  store:   { href: '/store',   label: 'store'   },
  archive: { href: '/archive', label: 'archive' },
};

const left  = links[leftLink]  ?? links.home;
const right = links[rightLink] ?? links.store;
---

<header class={`site-header ${white ? 'site-header--white' : 'site-header--black'}`}>
  <div class="header-inner">

    <div class="header-side header-side--left">
      <div class="header-deco" id="header-deco-left"></div>
      <a href={left.href} class="header-link">{left.label}</a>
    </div>

    <a href="/" class="header-logo" aria-label="Heart of Arah — home">
      <svg viewBox="0 0 147 73" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M79.838 41.831 L79.847 41.821 L73.130 35.104 L66.412 41.821 L66.450 41.859 L54.154 54.154 L0 0 L146.617 0 L92.312 54.305 L79.838 41.831 Z M78.338 43.331 L90.432 55.425 L73.158 72.698 L55.884 55.425 L67.950 43.359 L73.130 48.539 L78.338 43.331 Z"/>
      </svg>
    </a>

    <div class="header-side header-side--right">
      <div class="header-deco" id="header-deco-right"></div>
      <a href={right.href} class="header-link">{right.label}</a>
    </div>

  </div>
</header>

<style lang="scss">
  @use '../styles/variables' as *;

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 90px;
    display: flex;
    align-items: center;
  }

  .site-header--white {
    background: transparent;
    .header-link { color: $red-white; }
    .header-logo svg path { fill: $red-white; }
    .header-deco { border-color: rgba($red-white, 0.3); }
  }

  .site-header--black {
    background-color: $main-black;
    .header-link { color: $red-white; }
    .header-logo svg path { fill: $red-white; }
    .header-deco { border-color: rgba($red-white, 0.3); }
  }

  .header-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .header-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    &--right {
      align-items: flex-end;
    }
  }

  .header-deco {
    width: 60px;
    height: 0;
    border-top: 1px solid;
    animation: header-deco-grow 0.6s ease-out forwards;
  }

  @keyframes header-deco-grow {
    from { width: 0; }
    to   { width: 60px; }
  }

  .header-link {
    font-family: $font-body;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: lowercase;
    opacity: 0.7;
    transition: opacity 0.2s ease;
    &:hover { opacity: 1; }
  }

  .header-logo {
    display: flex;
    justify-content: center;
    svg {
      width: 100px;
      height: auto;
    }
  }
</style>
