---
// Faithful port of the original Footer: 100px bar, the original site's own
// icon SVGs on the left, copyright on the right.
// white={true} → cream footer with dark icons; white={false} → deep-blue with cream.
import { readFileSync } from 'node:fs';
import { siteConfig } from '../config.js';

interface Props { white?: boolean; }
const { white = false } = Astro.props;

const instagram = readFileSync(new URL('../../public/icon-instagram.svg', import.meta.url), 'utf8');
const facebook  = readFileSync(new URL('../../public/icon-facebook.svg',  import.meta.url), 'utf8');
const tiktok    = readFileSync(new URL('../../public/icon-tiktok.svg',    import.meta.url), 'utf8');
---

<section class={`footer ${white ? 'footer--white' : 'footer--black'}`}>
  <div class="left">
    <a class="svg-link" href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" set:html={instagram} />
    <a class="svg-link" href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" set:html={facebook} />
    <a class="svg-link" href={siteConfig.social.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" set:html={tiktok} />
  </div>
  <div class="right">
    <p>Copyright © {new Date().getFullYear()}</p>
  </div>
</section>

<style lang="scss">
  @use '../styles/variables' as *;

  .footer {
    width: 100%;
    height: 100px;

    .left {
      float: left;
      padding: 30px;
      display: flex;
    }

    .svg-link {
      display: block;
      margin: 10px;

      :global(svg) {
        width: 25px;
        height: 25px;
        display: block;
      }
    }

    .right {
      float: right;
      padding: 30px;
      p { margin: 10px 0; }
    }

    &::after { content: ''; display: block; clear: both; }
  }

  .footer--white {
    background-color: $red-white;
    p { color: $red-black; }
    .svg-link :global(*) { fill: $red-black; }
  }

  .footer--black {
    background-color: $deep-blue;
    p { color: $red-white; }
    .svg-link :global(*) { fill: $red-white; }
  }
</style>
