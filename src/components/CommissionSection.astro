---
// Faithful port of the original Commissions component:
// "Commissions are Open/Closed" + a 200px bordered button, side by side,
// centred in a 500px row. dark={true} → dark text/border (for cream bg),
// dark={false} → cream text/border (for dark bg).
import { siteConfig } from '../config.js';

interface Props { dark?: boolean; }
const { dark = false } = Astro.props;

const open = siteConfig.commissionsOpen;
---

<div class={`commissions ${dark ? 'commissions--dark' : 'commissions--light'}`}>
  <div class="holder">
    <div class="left-right-holder">
      <div class="left">
        <h1>{open ? 'Commissions are Open' : 'Commissions are Closed'}</h1>
      </div>
      <div class="right">
        <a href="/commission-form">
          <button type="button">{open ? 'Place an Order' : 'Request an Order'}</button>
        </a>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  @use '../styles/variables' as *;

  .commissions {
    width: 100%;
    min-height: 160px;
    height: auto;
    position: relative;
    padding-top: 30px;
  }

  .holder { margin: 0 auto; }

  .left-right-holder {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    min-height: 100px;
    max-width: 500px;
    margin: 0 auto;

    .left, .right { width: max-content; }

    .left {
      display: table;
      h1 {
        text-align: center;
        font-weight: 500;
        margin: 20px;
        min-width: 200px;
        font-size: clamp(18px, 2vw, 20px);
        font-family: $font-body;
        letter-spacing: 2px;
      }
    }

    .right {
      display: table;
      a { text-decoration: none; }
      button {
        width: 200px;
        padding: 15px;
        font-size: 18px;
        letter-spacing: 2px;
        height: 54px;
        display: block;
        cursor: pointer;
        background-color: transparent;
        font-family: $font-body;
      }
    }

    @media screen and (max-width: 500px) {
      display: block;
      .left, .right {
        width: 100%;
        display: flex;
        justify-content: center;
      }
    }
  }

  .commissions--dark {
    .left h1 { color: $deep-blue; }
    .right button { color: $deep-blue; border: 2px solid $deep-blue; }
  }

  .commissions--light {
    .left h1 { color: $red-white; }
    .right button { color: $red-white; border: 2px solid $red-white; }
  }
</style>
